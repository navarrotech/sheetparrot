        {{@includeFile(it.dir + "/views/partials/_global_head.squirrelly", it)/}}
        <title>Privacy Policy | SheetParrot</title>
    </head>
    <body>
        <!-- Header -->
        <div class="header shadow20 p-3">
            <div class="container">
                <nav class="navbar" role="navigation" aria-label="main navigation">
                    <div class="navbar-brand">
                        <a class="field is-grouped is-vcentered" href="{{it.domain}}/home">
