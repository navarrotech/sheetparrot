        <footer>
            {{@includeFile(it.dir + "/views/partials/_global_foot.squirrelly", it)/}}
            <script>
                let toggle_marketing = $('#cookie_toggle_marketing')

                toggle_marketing.attr('checked', localStorage && localStorage.getItem('cookie_marketing_disabled') == 'true'?false:true)
                toggle_marketing.on('change', () => {
                    localStorage && localStorage.setItem('cookie_marketing_disabled', !toggle_marketing.is(':checked'))
                })

                let toggle_analytics = $('#cookie_toggle_analytics')

                toggle_analytics.attr('checked', localStorage && localStorage.getItem('cookie_analytics_disabled') == 'true'?false:true)
                toggle_analytics.on('change', () => {
                    localStorage && localStorage.setItem('cookie_analytics_disabled', !toggle_analytics.is(':checked'))
                })
            </script>
        </footer>
    </body>
</html>