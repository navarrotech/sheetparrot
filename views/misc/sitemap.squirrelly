<?xml version="1.0" encoding="UTF-8"?>
<urlset
      xmlns="https://www.sitemaps.org/schemas/sitemap/0.9"
      xmlns:xhtml="http://www.w3.org/1999/xhtml"
      xmlns:mobile="http://www.google.com/schemas/sitemap-mobile/1.0"
      xmlns:image="http://www.google.com/schemas/sitemap-image/1.1"
      xmlns:xsi="https://www.w3.org/2001/XMLSchema-instance"
      xsi:schemaLocation="https://www.sitemaps.org/schemas/sitemap/0.9
            https://www.sitemaps.org/schemas/sitemap/0.9/sitemap.xsd">

    <url>
        <loc>{{it.domain}}/</loc>
        <changefreq>daily</changefreq>
        <priority>1.00</priority>
    </url>

    <url>
        <loc>{{it.domain}}/create</loc>
        <changefreq>daily</changefreq>
        <priority>0.7</priority>
    </url>

    <url>
        <loc>{{it.domain}}/support</loc>
        <changefreq>daily</changefreq>
        <priority>0.7</priority>
    </url>

    <url>
        <loc>{{it.domain}}/pricing</loc>
        <changefreq>daily</changefreq>
        <priority>0.7</priority>
    </url>

    <url>
        <loc>{{it.domain}}/login</loc>
        <changefreq>daily</changefreq>
        <priority>0.7</priority>
    </url>
    
    <url>
        <loc>{{it.domain}}/signup</loc>
        <changefreq>daily</changefreq>
        <priority>0.7</priority>
    </url>
    
    <url>
        <loc>{{it.domain}}/signup</loc>
        <changefreq>daily</changefreq>
        <priority>0.7</priority>
    </url>
    
    <url>
        <loc>{{it.domain}}/privacy-policy</loc>
        <changefreq>monthly</changefreq>
        <priority>0.7</priority>
    </url>
    <url>
        <loc>{{it.domain}}/terms-of-service</loc>
        <changefreq>monthly</changefreq>
        <priority>0.7</priority>
    </url>
    <url>
        <loc>{{it.domain}}/refund-policy</loc>
        <changefreq>monthly</changefreq>
        <priority>0.7</priority>
    </url>

</urlset>