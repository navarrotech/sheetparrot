<!doctype html>
<html>
    <head>
        <title>We want to hear from you!</title>
        {{@includeFile(it.dir + "/views/partials/_tracking_header.squirrelly", it)/}}
        {{@includeFile(it.dir + "/views/partials/_global_head.squirrelly", it)/}}
    </head>
        <body>
            <div class="hero is-primary is-medium">
                <div class="hero-body">
                </div>
            </div>
            <div class="container" style="margin-top:-200px;">
                <div class="columns">
                    <div class="column is-3"></div>
                    <div class="column">
    
                        <div class="box">
    
                            <div class="block">
                                <div class="image is-96x96 is-centered">
                                    <img src="{{it.domain}}/images/logo.svg"/>
                                </div>
                            </div>

                            <form class="container is-tiny" method="POST" action="{{it.domain}}/feedback">
                    
                                <div class="block">
                                    <p class="title has-text-centered is-size-2">
                                        Give feedback to SheetParrot
                                    </p>
                                </div>

                                <div class="block">
                                    <p class="is-size-7">
                                        Thank you for using SheetParrot! What did you think of our app?<br><br>We'd love to know how we can improve. <b>Our team takes time to read every single response</b>, and we truly appreciate your feedback.
                                    </p>
                                </div>
                                
                                <div class="block">
                
                                    <div class="field">
                                        <div class="control">
                                            <input class="input" name="name" type="text" placeholder="Name (optional)" {{@if(it.user && it.user.name)}}value="{{it.user.name}}"{{/if}}>
                                        </div>
                                    </div>
                
                                    <div class="field">
                                        <div class="control">
                                            <input class="input" name="email" type="email" placeholder="Email Address (optional)" {{@if(it.user && it.user.email)}}value="{{it.user.email}}"{{/if}}>
                                        </div>
                                    </div>
                
                                    <div class="field">
                                        <div class="control">
                                            <textarea class="textarea" name="message" placeholder="Let us know what you think" maxlength="2000" required></textarea>
                                        </div>
                                    </div>
                                </div>

                                <div class="block buttons is-centered mb-3">
                                    <button type="submit" class="button is-success">
                                        <span>
                                            Submit Feedback
                                        </span>
                                    </button>
                                </div>

                            </form>
    
                        </div>
    
                    </div>
                    <div class="column is-3"></div>
                </div>
            </div>
            
            {{@includeFile(it.dir + "/views/partials/_global_foot.squirrelly", it)/}}

        </body>
</html>
