<!-- Pricing -->
<div class="block container is-max-desktop pricingHeader">

    <div class="pricing-header">
        <div class="pricing-text is-cera">
            <h1 class="title superTitle has-text-weight-bold mb-0 has-text-centered-mobile">Pricing Optimized<br>For Teachers</h1>
            <h2 class="title has-text-weight-light is-size-2 has-text-centered-mobile">Designed to <span class="has-text-primary has-text-weight-semibold">replace the cost of<br class="is-hidden-mobile"> paper and ink</span> per month</h2>
