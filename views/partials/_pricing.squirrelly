    </div>

</div>

<div class="block container is-max-widescreen">
    <!-- For Individuals -->
    <div id="pricing_for_individuals">

        <div class="columns">
            <div class="column is-4 is-offset-2">
                <!-- Free Forever Plan -->
                <div class="price-box" id="pricing_free">
                    <div class="price is-montserrat">
                        <h1 class="title">Free</h1>
                        <div>
                            <span class="cost">$0</span>
                            <span class="term">/ forever</span>
                        </div>
                    </div>
                    <div class="price-cta">
                        <a class="button is-normal is-fullwidth is-hidden">Get Started For Free</a>
                    </div>
                    <div class="features">
                        <p><b>Up To 3 Sheets Per Month</b></p>
                        <p>Supports up to 100 students</p>
                        <p>100% Free For Students To Use</p>
                        <p>Grading & Review Tools</p>
                        <p>SheetParrot's Logo And Branding</p>
                    </div>
                </div>
            </div>
            <!--<div class="column">
                <!-- Basic Plan 
