<!-- // Begin Global Code // -->
<meta content="utf-8" http-equiv="encoding"> 
<meta name="viewport" content="width=device-width, initial-scale=1.0">

{{@if(!it.skipMeta)}}

<!-- Metadata -->
<link rel="icon" type="image/png" href="{{it.domain}}/images/logo.svg">
<meta class="metaTagTop" name="description" content="">
<meta class="metaTagTop" name="keywords" content="SheetParrot">
<meta class="metaTagTop" name="author" content="SheetParrot">
<meta class="metaTagTop" property="og:image" content="{{it.domain}}/images/logo.svg" id="social-image">
<meta property="og:title" content="SheetParrot">
<meta property="og:description" content="">
<meta property="og:url" content="{{it.requesting_url}}">
<meta property="og:type" content="website">

{{/if}}

<!-- Google Authentication -->
<meta name="google-signin-client_id" content="{{it.ENV.GOOGLE_CLIENT_ID}}">

{{@if(!it.ENV.DOMAIN.includes('http://localhost'))}}
{{@if(it.user && it.user.first_name && it.user.email)}}
<!-- Authenticated Freshchat Session -->
<script>
    function initFreshChat() {
    window.fcWidget.init({
        token: "26706b0c-94f6-461f-8670-fcb59e53f37d",
        host: "https://wchat.freshchat.com",
        firstName: "{{it.user.first_name}}",
        lastName: "{{it.user.last_name}}",
        email: "{{it.user.email}}",
        plan: "{{it.user.preferences.billing.plan}}"
    });
    }
console.log("Freshchat: Successfully authenticated session")
</script>
{{#else}}

<!-- Unauthenticated Freshchat Session -->
<script>
function initFreshChat() {
    window.fcWidget.init({
    token: "26706b0c-94f6-461f-8670-fcb59e53f37d",
    host: "https://wchat.freshchat.com",
    });
}
console.warn("Freshchat: Anonymous session actived")
</script>
{{/if}}
<!-- FreshChat Initialization -->
<script>function initialize(i,t){var e;i.getElementById(t)?initFreshChat():((e=i.createElement("script")).id=t,e.async=!0,e.src="https://wchat.freshchat.com/js/widget.js",e.onload=initFreshChat,i.head.appendChild(e))}function initiateCall(){initialize(document,"Freshdesk Messaging-js-sdk")}window.addEventListener?window.addEventListener("load",initiateCall,!1):window.attachEvent("load",initiateCall,!1);</script>
{{/if}}

{{@if(!it.domain.includes('localhost'))}}
