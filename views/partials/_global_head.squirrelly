{{@if(it.user && it.user.name && it.user.email)}}
<script type="text/javascript">
    try{
    rg4js('setUser', {
        identifier: '{{it.user.email}}',
        isAnonymous: false,
        email: '{{it.user.email}}',
        firstName: '{{it.user.first_name}}',
        fullName: '{{it.user.name}}'
    });
    rg4js('enablePulse', true); // Enables Real User Monitoring
    }
    catch(e){
        console.log("Unable to initialize RayGun Session on this page!")
    }
</script>-->
{{#else}}
<script type="text/javascript">
    rg4js('setUser', { isAnonymous: true });
</script>
{{/if}}
{{/if}}

<!-- SheetParrot CSS -->
<link rel="stylesheet" href="{{it.domain}}/css/SheetParrot.min.css?version={{it.css_version}}">

<!-- Fonts: Cabin, Montserrat, Poppins, Quicksand, PT Mono and Roboto-->
<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link href="https://fonts.googleapis.com/css2?family=Cabin:ital,wght@0,400;0,500;0,600;0,700;1,400;1,500;1,600;1,700&family=Montserrat:ital,wght@0,100;0,200;0,300;0,400;0,500;0,600;0,700;0,800;0,900;1,100;1,200;1,300;1,400;1,500;1,600;1,700;1,800;1,900&family=Poppins:ital,wght@0,100;0,200;0,300;0,400;0,500;0,600;0,700;0,800;0,900;1,100;1,200;1,300;1,400;1,500;1,600;1,700;1,800;1,900&family=Quicksand:wght@300;400;500;600;700&family=Roboto:ital,wght@0,100;0,300;0,400;0,500;0,700;0,900;1,100;1,300;1,400;1,500;1,700;1,900&family=PT+Mono&display=swap" rel="stylesheet">

<script>
    const _DOMAIN = "{{it.domain}}";
    const _EMAIL = "{{@if(it.authorized)}}{{it.user.email}}{{#else}}anonymous{{/if}}";
    const _ENV = "{{it.ENV.NODE_ENV}}";
    var AUTHORIZED = "{{it.authorized}}" == "true" ? true : false;
    const _PLAN = "{{@if(it.authorized && it.user)}}{{@if(it.user.is_vip == true)}}professional{{#else}}{{it.user.preferences.billing.plan}}{{/if}}{{/if}}"
    const _PROFILE_PICTURE = "{{@if(it.authorized)}}{{it.user.profile_picture}}{{#else}}{{it.domain}}/images/{{/if}}";
</script>
<!-- // End Global Code // -->