            <script>
                /* <!-- Unauthenticated Freshchat Session --> */
                function initFreshChat() {
                    window.fcWidget.init({
                        token: "26706b0c-94f6-461f-8670-fcb59e53f37d",
                        host: "https://wchat.freshchat.com",
                    });
                }
                console.warn("Freshchat: Anonymous session mode")
                setTimeout(() => { function initialize(i,t){var e;i.getElementById(t)?initFreshChat():((e=i.createElement("script")).id=t,e.async=!0,e.src="https://wchat.freshchat.com/js/widget.js",e.onload=initFreshChat,i.head.appendChild(e))}function initiateCall(){initialize(document,"Freshdesk Messaging-js-sdk")}window.addEventListener?window.addEventListener("load",initiateCall,!1):window.attachEvent("load",initiateCall,!1); })
            </script>
            {{/if}}

            <!-- Fonts: Cabin, Montserrat, Poppins, Quicksand, PT Mono and Roboto-->
            <link rel="preconnect" href="https://fonts.googleapis.com">
            <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
            <link href="https://fonts.googleapis.com/css2?family=Cabin:ital,wght@0,400;0,500;0,600;0,700;1,400;1,500;1,600;1,700&family=Montserrat:ital,wght@0,100;0,200;0,300;0,400;0,500;0,600;0,700;0,800;0,900;1,100;1,200;1,300;1,400;1,500;1,600;1,700;1,800;1,900&family=Poppins:ital,wght@0,100;0,200;0,300;0,400;0,500;0,600;0,700;0,800;0,900;1,100;1,200;1,300;1,400;1,500;1,600;1,700;1,800;1,900&family=Quicksand:wght@300;400;500;600;700&family=Roboto:ital,wght@0,100;0,300;0,400;0,500;0,700;0,900;1,100;1,300;1,400;1,500;1,700;1,900&family=PT+Mono&display=swap" rel="stylesheet">
            <script>establishReferrer();</script>
            <script>cookieBanner();</script>

            <script>
                let iframes = document.querySelectorAll('iframe')
                iframes.forEach(frame => {
                    let src = frame.getAttribute('data-src')
                    frame.removeAttribute('data-src')
                    if(localStorage && localStorage.getItem('cookie_analytics_disabled') == 'true'){ src += '&dnt=true' }
                    frame.setAttribute('src', src)
                })
            </script>
        </footer>

    </body>
</html>