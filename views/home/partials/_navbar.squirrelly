                <a class="item{{@if(it.url && it.url == '/pricing'}} is-active{{/if}}" href="{{it.domain}}/pricing">
                    <span>Pricing</span>
                </a>
                <a class="item{{@if(it.url && it.url == '/support'}} is-active{{/if}}" href="{{it.domain}}/support">
