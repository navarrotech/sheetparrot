        <hr>

        <div class="twobox also-mobile">
            <a class="hamburger-item is-colorful" href="{{it.domain}}/signup" data-action="signup">
                <span class="icon"><i class="fas fa-user-plus"></i></span>
                <span>Signup</span>
            </a>
            <a class="hamburger-item is-primary" href="{{it.domain}}/login">
                <span class="icon"><i class="fas fa-sign-in-alt"></i></span>
                <span>Login</span>
            </a>
        </div>
        
    </div>

</div>

<script>
    (function(){
        if(window.location.pathname != "/"){ return; }

        let scrolling_element = document.querySelector('html'),
            navbar = document.querySelector('.navigation')
        document.addEventListener('scroll', (e) => {
            let depth = (window.scrollY)
            if(depth == 0){ navbar.classList.add('is-top'); }
            else{ navbar.classList.remove('is-top'); }
        })
    })();
</script>
<script>
    (function(){
        let hamburger_icon = document.querySelector('.navigation .hamburger'),
            hamburger_menu = document.querySelector('.mobile-hamburger-menu'),
            navigation     = document.querySelector('.navigation')

        if(!hamburger_icon || !hamburger_menu || !navigation){return;}
        hamburger_icon.addEventListener('click', () => {
            if(hamburger_menu.classList.contains('is-active')){
                hamburger_menu.classList.remove('is-active')
                navigation.classList.remove('hamburger-active')
                hamburger_menu.querySelector('.innerHamburger').focus()
            }
            else {
                hamburger_menu.classList.add('is-active')
                navigation.classList.add('hamburger-active')
            }
        })
    })();
</script>