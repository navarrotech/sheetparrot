<!doctype html>
<html lang="en">
    <head>
        
        <title>SheetParrot | Failed Payment</title>
        {{@includeFile(it.dir + "/views/partials/_tracking_header.squirrelly", it)/}}
        
        {{@includeFile(it.dir + "/views/partials/_global_head.squirrelly", it)/}}
        
        <style>
            .box.tinyBox, .box.smallBox{
                margin-top:30px;
                background:white;
                border-radius:8px;
                padding-top:2.6em;
                padding-bottom:2.6em;
                display:block;
                margin-left:auto;
                margin-right:auto;
            }
            .box.tinyBox{
                width:380px;
            }
            .box.smallBox{
                width:500px;
            }
            .is-page-top{
                padding-top:10vh;
            }
            @media only screen and (max-width: 768px){
                .box.tinyBox, .box.smallBox{
                    width:100%;
                }
            }
            .credit-card{
                width: 300px;
                height: 178px;
                position: relative;
                margin: 0 auto;
                background-color: #f1404b;
                overflow: hidden;
                z-index: 1;
                -webkit-border-radius: 6px;
                -moz-border-radius: 6px;
                border-radius: 6px;
                -webkit-box-shadow: 0 15px 24px rgb(37 44 65 / 32%);
                -moz-box-shadow: 0 15px 24px rgba(37,44,65,0.32);
                box-shadow: 0 15px 24px rgb(37 44 65 / 32%);
            }
            .credit-card-content {
                width: 100%;
                padding: 20px;
                position: relative;
                float: left;
                z-index: 1;
            }
            .credit-card h6{
                font-family: 'PT Mono';
                font-size: 18px;
                font-weight: 400;
                color: #f4f5f9;
                letter-spacing: 0px;
                text-align: left;
                text-transform: uppercase;
                line-height: 1.8;
            }
            .credit-card h5{
                font-size: 11px;
                font-weight: 700;
                color: #c9d6de;
                letter-spacing: 1px;
                text-align: left;
                text-transform: uppercase;
                font-family: 'Quicksand', sans-serif;
            }
            .credit-card h5 > span {
                margin-left: 87px;
            }
            .credit-card h6 > span {
                margin-left: 74px;
            }
            .credit-card-wave {
                height: 300px;
                width: 300px;
                position: relative;
                background: #780910;
                z-index: -1;
            }
            .credit-card-wave:before {
                height: 360px;
                width: 360px;
                left: -5%;
                top: -70%;
            }
            .credit-card-wave:after {
                height: 300px;
                width: 300px;
                left: 30%;
                top: 20%;
                opacity: 0.8;
            }
            .credit-card-wave:before, .credit-card-wave:after {
                content: "";
                display: block;
                position: absolute;
                background: rgba(193,14,26,1);
                background: -moz-linear-gradient(top, rgba(193,14,26,1) 0%, rgba(241,64,76,0.3) 100%);
                background: -webkit-gradient(left top, left bottom, color-stop(0%, rgba(193,14,26,1)), color-stop(100%, rgba(241,64,76,0.3)));
                background: -webkit-linear-gradient(top, rgba(193,14,26,1) 0%, rgba(241,64,76,0.3) 100%);
                background: -o-linear-gradient(top, rgba(193,14,26,1) 0%, rgba(241,64,76,0.3) 100%);
                background: -ms-linear-gradient(top, rgba(193,14,26,1) 0%, rgba(241,64,76,0.3) 100%);
                background: linear-gradient(to bottom, rgba(193,14,26,1) 0%, rgba(241,64,76,0.3) 100%);
                filter: progid:DXImageTransform.Microsoft.gradient( startColorstr='#c10e1a', endColorstr='#f1404c', GradientType=0 );
                -webkit-border-radius: 50% 50%;
                -moz-border-radius: 50% 50%;
                border-radius: 50% 50%;
            }
            .credit-card .logo-visa {
                position: relative;
                margin-top: -20px;
                left: 95px;
            }
        </style>
    </head>
    <body>

        <!-- Message -->
        <div class="container is-max-desktop is-page-top">

            <h1 class="block title has-text-centered">Your most recent payment of {{@formatStripeNumber(it.failed_card.amount)/}} failed</h1>
            <div class="box smallBox">

                <div class="">
                    <div class="block credit-card">
                        <div class="credit-card-content">
                            <svg class="logo-visa {{@if(it.failed_card.brand != "visa")}}is-invisible{{/if}}" enable-background="new 0 0 50 70" height="70px" version="1.1" viewBox="0 0 50 50" width="70px" xml:space="preserve" xmlns="http://www.w3.org/2000/svg" xmlns:xlink="http://www.w3.org/1999/xlink">
                                <g><g><polygon clip-rule="evenodd" fill="#f4f5f9" fill-rule="evenodd" points="17.197,32.598 19.711,17.592 23.733,17.592     21.214,32.598   "></polygon><path clip-rule="evenodd" d="M35.768,17.967c-0.797-0.287-2.053-0.621-3.596-0.621    c-3.977,0-6.752,2.029-6.776,4.945c-0.023,2.154,1.987,3.358,3.507,4.08c1.568,0.738,2.096,1.201,2.076,1.861    c0,1.018-1.238,1.471-2.395,1.471c-1.604,0-2.455-0.232-3.773-0.787l-0.53-0.248l-0.547,3.348    c0.929,0.441,2.659,0.789,4.462,0.811c4.217,0,6.943-2.012,6.979-5.135c0.025-1.692-1.053-2.999-3.369-4.071    c-1.393-0.685-2.246-1.134-2.246-1.844c0-0.645,0.723-1.306,2.295-1.306c1.314-0.024,2.268,0.271,3.002,0.58l0.365,0.167    L35.768,17.967z" fill="#f4f5f9" fill-rule="evenodd"></path><path clip-rule="evenodd" d="M46.055,17.616h-3.102c-0.955,0-1.688,0.272-2.117,1.24    l-5.941,13.767h4.201c0,0,0.688-1.869,0.852-2.262c0.469,0,4.547,0,5.133,0c0.123,0.518,0.49,2.262,0.49,2.262h3.711    L46.055,17.616 M41.1,27.277c0.328-0.842,1.609-4.175,1.609-4.175c-0.041,0.043,0.328-0.871,0.529-1.43l0.256,1.281    c0,0,0.773,3.582,0.938,4.324H41.1z" fill="#f4f5f9" fill-rule="evenodd"></path><path clip-rule="evenodd" d="M13.843,17.616L9.905,27.842l-0.404-2.076    c-0.948-2.467-2.836-4.634-5.53-6.163l3.564,12.995h4.243l6.312-14.982H13.843z" fill="#f4f5f9" fill-rule="evenodd"></path><path clip-rule="evenodd" d="M7.232,17.174H0.755l-0.037,0.333    c5.014,1.242,8.358,4.237,9.742,7.841l-1.42-6.884C8.798,17.507,8.105,17.223,7.232,17.174L7.232,17.174z" fill="#f4f5f9" fill-rule="evenodd"></path></g></g>
                            </svg>
                            <h5>Card Number</h5>
                            {{@if(it.failed_card)}}
                            <h6 class="label-cardnumber">**** **** **** {{it.failed_card.payment_method_details.card.last4}}</h6>
                            {{#else}}
                            <h6 class="label-cardnumber">0000 0000 0000 0000</h6>
                            {{/if}}

                            <h5>Expiration<span>CVC</span></h5>

                            {{@if(it.failed_card)}}
                            <h6 class="label-cardexpiration">{{it.failed_card.payment_method_details.card.exp_month}} / {{it.failed_card.payment_method_details.card.exp_year}}<span>***</span></h6>
                            {{#else}}
                            <h6 class="label-cardexpiration">00 / 0000<span>000</span></h6>
                            {{/if}}
                        </div>
                        <div class="credit-card-wave"></div>
                    </div>
                    <div class="block is-size-7">

                        <p class="block">
                            SheetParrot attempted to charge your card to pay for your monthly subscription, but the payment failed.
                        </p>
                        <p class="block">
                            We will retry to charge your card for {{@formatStripeNumber(it.failed_card.amount)/}} automatically over the next 2 weeks.
                        </p>
                        <p class="block">
                            If we are unable to collect payment before {{it.failed_card.retry_expires}}, <b>we will be forced cancel your account</b> and you will lose paid features.
                        </p>
                        <p class="block">
                            Having your account downgraded <b>may result in the deletion of your sheets, images, student submissions, and more.</b>
                        </p>
                        <p class="block">
                            Update your payment information now to prevent losing your account's features!
                        </p>
                        
                    </div>
                    <div class="block buttons is-centered">
                        <a class="button is-light" href="{{it.domain}}/billing">
                            <span class="icon">
                                <i class="fas fa-arrow-left"></i>
                            </span>
                            <span>Back</span>
                        </a>
                        <a class="button is-primary" href="{{it.domain}}/billing/paymentMethods">
                            <span>Add a new card</span>
                            <span class="icon">
                                <i class="fas fa-plus"></i>
                            </span>
                        </a>
                    </div>
                </div>

            </div>
        </div>

    </body>
</html>
