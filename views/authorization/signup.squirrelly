        {{@includeFile(it.dir + "/views/partials/_global_foot.squirrelly", it)/}}

        <script src="{{it.domain}}/js/authentication/authentication.js"></script>

        <script>
            let auth = new Authenticator({
                type:"any",
                auth:"signup",
                includeBox:false,
                subtitle:'Teacher signup • No credit card required'
            })
            auth.render();
            $('.authParent').html( auth.elements._root );
            </script>
