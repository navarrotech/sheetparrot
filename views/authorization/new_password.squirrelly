<!doctype html>
<html>
    <head>
        <title>SheetParrot | Forgot Password</title>
        {{@includeFile(it.dir + "/views/partials/_tracking_header.squirrelly", it)/}}
        {{@includeFile(it.dir + "/views/partials/_global_head.squirrelly", it)/}}
    </head>

    <body>
        <div class="hero is-primary is-medium">
            <div class="hero-body">
            </div>
        </div>
        <div class="container has-text-centered" style="margin-top:-200px;">
            <div class="columns">
                <div class="column is-4"></div>
                <div class="column">

                    <div class="box">

                        <div class="block">
                            <div class="image is-96x96 is-centered">
                                <img src="{{it.domain}}/images/logo.svg"/>
                            </div>
                        </div>
                        
                    {{@if(it.can_reset)}}
                        <div class="block" id="step_1">
                            <h1 class="block title is-size-3">
                                Set your password
                            </h1>
                            <p class="block is-size-6 has-text-centered">
                                Set the new password that will be used for your account.
                            </p>
                            <div class="block field">
                                <p class="control has-icons-left">
                                    <input class="input" name="email" type="email" placeholder="email" value="{{it.email}}" disabled>
                                    <span class="icon is-small is-left"> <i class="fas fa-envelope"></i> </span> <span class="icon is-small is-right"> </span>
                                </p>
                            </div>
                            <div class="block field">
                                <p class="control has-icons-left">
                                    <input class="input" name="new-password" type="password" placeholder="New Password" autocomplete="new-password" id="pass">
                                    <span class="icon is-small is-left"> <i class="fas fa-lock"></i> </span> <span class="icon is-small is-right"> </span> 
                                </p>
                                <p class="help is-danger is-hidden" id="input_help">Please enter a valid password, at least 8 characters long.</p>
                            </div>
                            <a class="button is-success mb-3 is-fullwidth" id="continuer">Set new password</a>
                        </div>
                        <div class="is-hidden" id="step_2">
                            <h1 class="block title is-size-3">
                                New password is set!
                            </h1>
                            <p class="block is-size-6 has-text-centered">
                                Your account's password has been updated successfully, and you'll need to use it to login in the future.
                            </p>
                            <a class="button is-primary mb-3 is-fullwidth" href="{{it.domain}}/login">
                                <span>Login to SheetParrot</span>
                                <span class="icon">
                                    <i class="fas fa-arrow-right"></i>
                                </span>
                            </a>
                        </div>
                        
                    {{#else}}

                        <div class="block">
                            <h1 class="block title is-size-3">
                                Reset link has expired!
                            </h1>
                            <p class="block is-size-6 has-text-centered">
                                Your reset link has either expired or doesn't exist.
                            </p>
                            <a class="button is-primary mb-3 is-fullwidth" href="{{it.domain}}/reset-password">
                                <span>Reset my password again</span>
                                <span class="icon">
                                    <i class="fas fa-link"></i>
                                </span>
                            </a>
                            <a class="button is-light mb-3 is-fullwidth" href="{{it.domain}}/login">
                                <span>Login to SheetParrot</span>
                                <span class="icon">
                                    <i class="fas fa-arrow-right"></i>
                                </span>
                            </a>
                        </div>

                    {{/if}}

                        
                    </div>
                    <p class="mt-3 is-size-6 has-text-centered">
                        Don't have a SheetParrot account yet?
                        &nbsp;<a href="{{it.domain}}/signup">
                            Sign Up
                        </a>
                    </p>

                </div>
                <div class="column is-4"></div>
            </div>
        </div>
        
        {{@includeFile(it.dir + "/views/partials/_global_foot.squirrelly", it)/}}

        {{@if(it.can_reset)}}
            <script>
                (function(){

                    let step_1 = $('#step_1'),
                        step_2 = $('#step_2')

                    let continuer = $('#continuer'),
                        pass      = $('#pass'),
                        helper    = $('#input_help')

                    let token_1 = "{{it.token_1}}",
                        token_2 = "{{it.token_2}}",
                        email   = "{{it.email}}"

                    continuer.click(async () => {

                        if(!pass.val() || !pass.val().length >= 8){
                            pass.addClass('is-danger')
                            helper.removeClass('is-hidden')
                            return;
                        }
                        
                        continuer.addClass('is-loading')
                        
                        let result = await $POST('/new-password', { token_1, token_2, email, value:pass.val() })
                        console.log(result)

                        step_1.addClass('is-hidden')
                        step_2.removeClass('is-hidden')
                    })
                    pass.on('input', () => {
                        helper.addClass('is-hidden')
                        pass.removeClass('is-danger')
                    })
                })()
            </script>
            {{/if}}

    </body>

</html>