<!doctype html>
<html>
    <head>
        <title>SheetParrot | Forgot Password</title>
        {{@includeFile(it.dir + "/views/partials/_tracking_header.squirrelly", it)/}}
        {{@includeFile(it.dir + "/views/partials/_global_head.squirrelly", it)/}}
    </head>

    <body>
        <div class="hero is-primary is-medium">
            <div class="hero-body">
            </div>
        </div>
        <div class="container has-text-centered" style="margin-top:-200px;">
            <div class="columns">
                <div class="column is-4"></div>
                <div class="column">

                    <div class="box">

                        <div class="block">
                            <div class="image is-96x96 is-centered">
                                <img src="{{it.domain}}/images/logo.svg"/>
                            </div>
                        </div>
                        
                        <div class="block has-text-centered" id="step_1">
                            <h1 class="block title is-size-3">
                                Password Reset
                            </h1>
                            <p class="block is-size-6">
                                Enter the email address associated with your account and we'll send you a link to reset your password.
                            </p>
                            <div class="block">
                                <p class="control has-icons-left has-icons-right">
                                    <input class="input" name="email" type="email" placeholder="Email" autocomplete="email">
                                    <span class="icon is-small is-left"> <i class="fas fa-envelope"></i> </span> <span class="icon is-small is-right"> </span> 
                                </p>
                                <p class="help is-danger is-hidden" id="input_help">Please enter a valid email address</p>
                            </div>
                            <div class="block">
                                <a class="button is-success is-fullwidth" id="login">Continue</a>
                            </div>
                            <div class="block">
                                <a class="button is-light is-fullwidth" href="{{it.domain}}/login">Return to login</a>
                            </div>
                            
                        </div>

                        <div class="block has-text-centered is-hidden" id="step_2">
                            <h1 class="block title is-size-3">
                                Great! If your account exists, you'll get an email to reset your password.
                            </h1>
                            <p class="block is-size-6">
                                Didn't get the email? Please your spam folder.
                            </p>
                        </div>
                        
                    </div>
                    <p class="mt-3 is-size-6 has-text-centered">
                        Don't have a SheetParrot account yet?
                        &nbsp;<a href="{{it.domain}}/signup">
                            Sign Up
                        </a>
                    </p>

                </div>
                <div class="column is-4"></div>
            </div>
        </div>
        
        {{@includeFile(it.dir + "/views/partials/_global_foot.squirrelly", it)/}}

        <script>
            (function(){

                let step_1 = $('#step_1'),
                    step_2 = $('#step_2')

                let login = $('#login'),
                    email = $('input[name=email]'),
                    help  = $('#input_help')

                login.click(async () => {
                    if(!email.val() || !email.val().includes('@') || !email.val().length > 3 || !email.val().includes('.')){
                        email.addClass('is-danger')
                        help.removeClass('is-hidden')
                        return;
                    }

                    login.addClass('is-loading')

                    let result = await $POST("/reset-password", { "email":email.val() })

                    console.log(result)

                    step_1.addClass('is-hidden')
                    step_2.removeClass('is-hidden')
                })

                email.on('input', () => {
                    email.removeClass('is-danger')
                    help.addClass('is-hidden')
                })
                
            })();
        </script>

    </body>

</html>