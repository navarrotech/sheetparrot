                                        <i class="fas fa-external-link-alt"></i>
                                    </span>
                                    <span>Preview</span>
                                </a>
                            </div>
                            <div class="control">
                                <a class="button is-primary" action="save">
                                    <span class="icon is-small"><i class="fas fa-save"></i></span>
                                    <span>Save</span>
                                </a>
                            </div>
                        </div>
                    </div>
                </div>
            </div>

            <div class="editor_navbar_spacer is-secondary"></div>

            <div class="editor"></div>
        </div>

